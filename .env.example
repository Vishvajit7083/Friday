# DEFAULT AI ENGINE: BUILT-IN LOCAL CORE + FREE LIVE WEB KNOWLEDGE
# No Ollama, no LM Studio, and no paid API key required out of the box!

# OPTIONAL ALTERNATIVE LOCAL LLM (LM Studio, Jan, llama.cpp server, LocalAI, etc.)
# Uncomment if you run an OpenAI-compatible local server instead of Built-In Mode:
# LOCAL_AI_BASE_URL="http://127.0.0.1:1234/v1"
# LOCAL_AI_MODEL="local-model"
# LOCAL_AI_API_KEY=""

# OPTIONAL OLLAMA (Only if you decide to use Ollama later)
# OLLAMA_HOST="http://127.0.0.1:11434"
# OLLAMA_MODEL=""

# OPTIONAL CLOUD AI KEY (Not required for normal conversations, web research, or voice)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server port (default 3000)
PORT="3000"

# FRIDAY_FULLSCREEN: Launch Electron desktop shell in borderless fullscreen ("true" | "false")
FRIDAY_FULLSCREEN="true"

# FRIDAY_REOPEN_SHORTCUT: Global desktop shortcut to restore F.R.I.D.A.Y. after pressing ESC
FRIDAY_REOPEN_SHORTCUT="CommandOrControl+Shift+Space"
