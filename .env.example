# GEMINI_API_KEY: Required for server-side Gemini AI reasoning, search grounding, vision, and TTS.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT="3000"

# FRIDAY_FULLSCREEN: Launch Electron desktop shell in borderless fullscreen ("true" | "false")
FRIDAY_FULLSCREEN="true"

# FRIDAY_REOPEN_SHORTCUT: Global desktop shortcut to restore F.R.I.D.A.Y. after pressing ESC
FRIDAY_REOPEN_SHORTCUT="CommandOrControl+Space"
